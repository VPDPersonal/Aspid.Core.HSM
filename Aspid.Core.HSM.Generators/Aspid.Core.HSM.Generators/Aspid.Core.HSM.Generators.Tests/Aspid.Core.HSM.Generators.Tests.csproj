<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>

        <RootNamespace>Aspid.Core.HSM.Generators.Tests</RootNamespace>

        <!-- Compiles the machine's profiler markers against the stub in Profiling/ProfilerMarker.cs. -->
        <DefineConstants>$(DefineConstants);ENABLE_PROFILER</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing.XUnit" Version="1.1.1"/>
        <!-- Lifts the testing package's Workspaces 3.8.0 pin up to the Roslyn version the generator targets. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.3.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.2"/>
        <PackageReference Include="xunit" Version="2.4.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="UniTask" Version="2.5.10"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Aspid.Core.HSM.Generators\Aspid.Core.HSM.Generators.csproj"/>
    </ItemGroup>

    <Import Project="..\..\RuntimeSources.props" />

</Project>
