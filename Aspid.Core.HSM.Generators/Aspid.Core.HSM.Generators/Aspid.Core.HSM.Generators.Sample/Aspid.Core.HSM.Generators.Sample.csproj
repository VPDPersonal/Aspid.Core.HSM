<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>Aspid.Core.HSM.Generators.Sample</RootNamespace>
        <!--        Dont support version-->
        <!--        <UnityVersion>6000.3.0f1</UnityVersion>-->
        <UnityVersion>6000.0.64f1</UnityVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Aspid.Core.HSM.Generators\Aspid.Core.HSM.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- The generator's bin/ output is not merged (see ILRepack.targets), so the compiler needs its
         dependencies as analyzers too, or the generator fails to load. The versions come from
         Directory.Build.props, shared with the generator. -->
    <ItemGroup>
        <PackageReference Include="Aspid.Generators.Helper" Version="$(AspidGeneratorsHelperVersion)" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
        <PackageReference Include="Aspid.Generators.Helper.Unity" Version="$(AspidGeneratorsHelperUnityVersion)" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
        <Analyzer Include="$(PkgAspid_Generators_Helper)/lib/netstandard2.0/Aspid.Generators.Helper.dll" />
        <Analyzer Include="$(PkgAspid_Generators_Helper_Unity)/lib/netstandard2.0/Aspid.Generators.Helper.Unity.dll" />
    </ItemGroup>

    <Import Project="..\..\RuntimeSources.props" />

    <ItemGroup>
        <Compile Include="$(HsmPackageDir)Unity\Runtime\StateMachines\MonoStateMachine*.cs" Link="Runtime\StateMachines\%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Unity3D" Version="3.1.1" />
      <PackageReference Include="UniTask" Version="2.5.10" />
    </ItemGroup>

</Project>
